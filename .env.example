# Dongle Backend — Environment Configuration Template
# Copy this file to .env.local and fill in your values

# ============================================================================
# SERVER CONFIGURATION
# ============================================================================

# Node environment
NODE_ENV=development

# Server port
PORT=3001

# Logging level (debug, info, warn, error)
LOG_LEVEL=debug

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================

# PostgreSQL connection string
# Format: postgresql://username:password@hostname:port/database
# Example: postgresql://dongle_user:secure_password@localhost:5432/dongle_dev
DATABASE_URL=postgresql://user:password@localhost:5432/dongle_dev

# Database pool configuration (optional)
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# ============================================================================
# STELLAR & SOROBAN CONFIGURATION
# ============================================================================

# Stellar network passphrase
# Testnet: "Test SDF Network ; September 2015"
# Public: "Public Global Stellar Network ; September 2015"
STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# Soroban RPC endpoint
# Testnet: https://soroban-testnet.stellar.org
# Public: https://soroban-mainnet.stellar.org
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# Stellar Horizon API endpoint (for transaction history, account info)
# Testnet: https://horizon-testnet.stellar.org
# Public: https://horizon.stellar.org
HORIZON_API_URL=https://horizon-testnet.stellar.org

# ============================================================================
# SMART CONTRACT CONFIGURATION
# ============================================================================

# Smart contract IDs (Soroban contract addresses)
# Format: C followed by 55 base32 characters (56 chars total)
# Get these from contract deployment

# Project registry contract (stores project metadata)
PROJECT_REGISTRY_CONTRACT=C__placeholder_project_registry_contract_id_________

# Review registry contract (stores reviews and ratings)
REVIEW_REGISTRY_CONTRACT=C__placeholder_review_registry_contract_id_____________

# Verification registry contract (stores verification requests)
VERIFICATION_REGISTRY_CONTRACT=C__placeholder_verification_registry_contract_id__

# ============================================================================
# INDEXING CONFIGURATION
# ============================================================================

# Enable/disable automatic Soroban event indexing
INDEXING_ENABLED=true

# Starting ledger for initial indexing (optional, for first-time sync)
# If not set, will start from current ledger
# Use when you have historical contract data
INDEXING_START_LEDGER=

# Indexer polling interval (milliseconds)
INDEXING_POLL_INTERVAL=6000

# Number of ledgers to fetch per indexing cycle
INDEXING_BATCH_SIZE=200

# ============================================================================
# AUTHENTICATION & AUTHORIZATION
# ============================================================================

# JWT secret for signing tokens (minimum 32 characters)
# Generate: openssl rand -base64 32
JWT_SECRET=your_jwt_secret_minimum_32_characters_long

# JWT token expiration (e.g., "7d", "24h", "30m")
JWT_EXPIRATION=7d

# Admin allowlist - comma-separated Stellar addresses authorized for admin operations
# Example: GXXXXX1,GXXXXX2,GXXXXX3
# Leave empty if no admins (all verification manual approval disabled)
ADMIN_ALLOWLIST=

# ============================================================================
# CORS & SECURITY
# ============================================================================

# Frontend origin(s) for CORS configuration
# Development: http://localhost:3000
# Production: https://dongle.app
FRONTEND_URL=http://localhost:3000

# Enable/disable CORS
CORS_ENABLED=true

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ============================================================================
# OPTIONAL: ERROR TRACKING & MONITORING
# ============================================================================

# Sentry DSN for error tracking (optional)
# Leave empty to disable Sentry integration
SENTRY_DSN=

# Datadog API key for metrics (optional)
DATADOG_API_KEY=

# Application name for monitoring
APP_NAME=dongle-backend

# ============================================================================
# OPTIONAL: CACHING
# ============================================================================

# Redis connection string for caching (optional)
# If not set, uses in-memory caching
# Format: redis://[user:password@]host:port
REDIS_URL=

# Cache TTL for project listings (seconds)
CACHE_PROJECT_LIST_TTL=300

# Cache TTL for single projects (seconds)
CACHE_PROJECT_DETAIL_TTL=600

# ============================================================================
# OPTIONAL: NOTIFICATIONS
# ============================================================================

# SendGrid API key for email notifications (optional)
SENDGRID_API_KEY=

# Email from address for notifications
NOTIFICATION_EMAIL_FROM=noreply@dongle.app

# ============================================================================
# DEVELOPMENT ONLY
# ============================================================================

# Seed test data in database (development only)
SEED_TEST_DATA=false

# Enable API documentation endpoint /api/docs
ENABLE_API_DOCS=true

# Database reset on startup (DANGEROUS - development only)
# Only use for local testing
DB_RESET_ON_START=false

# ============================================================================
# DEPLOYMENT NOTES
# ============================================================================

# For production deployment:
# 1. Set NODE_ENV=production
# 2. Provide valid smart contract IDs (deploy contracts first)
# 3. Set strong JWT_SECRET
# 4. Configure ADMIN_ALLOWLIST with verified admin addresses
# 5. Set FRONTEND_URL to production domain
# 6. Enable Sentry for error tracking
# 7. Set up PostgreSQL with backups
# 8. Configure monitoring (Datadog/etc)
# 9. Enable HTTPS/TLS
# 10. Review docs/DEPLOYMENT.md for full checklist

# See docs/DEPLOYMENT.md for production deployment guide
